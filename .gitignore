# ============================================================
# PlasmaDX-Clean .gitignore
# Clean, pattern-based ignores - NO individual file listings
# ============================================================

# ============================================================
# Git Worktrees
# ============================================================
.worktrees/

# ============================================================
# Build Outputs
# ============================================================
build/
build-*/
cmake-build-*/
bin/
obj/
out/
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.lib
*.exp

# ============================================================
# Visual Studio
# ============================================================
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj.filters

# ============================================================
# CMake
# ============================================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeLists.txt.user
CMakeScripts/
CMakeUserPresets.json
Testing/
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# ============================================================
# IDE / Editors
# ============================================================
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# ============================================================
# OS Files
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Compiled Shaders
# ============================================================
# Keep .hlsl source, ignore compiled binaries
# (Note: build system regenerates these)
*.cso
# *.dxil  # Keep dxil for now - build may need them

# ============================================================
# Python / ML
# ============================================================
# Virtual environments
venv/
.venv/
env/
ENV/
.env
.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter
.ipynb_checkpoints/

# ML artifacts
*.onnx.data
*.h5
*.keras
mlruns/
wandb/

# PyTorch checkpoints (optional - uncomment to ignore)
# *.pt
# *.pth

# ============================================================
# Generated / Cache Data
# ============================================================
logs/
*.log
*.tmp
*.temp
*.cache

# Local dev logs (do not commit)
OPENAI_DASHBOARD_LOG.md

# ============================================================
# Large Binary Assets (use Git LFS or external storage)
# ============================================================
# VDB/NanoVDB files - too large for git
VDBs/
*.vdb
*.nvdb

# Blender output directories
*_out/
vdb_cache/

# Image sequences (use external storage)
images/NanoVDB/
images/evaluation_outputs/

# Local agent runtime state (do not commit)
agents/blender-librarian/agents/

# ============================================================
# PIX / GPU Debugging
# ============================================================
PIX/
screenshots/

# ============================================================
# External SDKs (vendored separately)
# ============================================================
# Note: external/ is NOT ignored - contains required deps
# But specific large SDKs may be excluded:
external/RTXDI/
branch-backups/
# ============================================================
# Credentials / Secrets
# ============================================================
gha-creds-*.json
*.pem
*.key
secrets/
.gemini/

# ============================================================
# Keep Rules (override ignores above)
# ============================================================
# Keep Agility SDK DLLs in external
!external/D3D12/*.dll

# Keep ONNX model files (small, important)
!ml/models/*.onnx
!ml/models/*.json

# Keep ML source and docs
!ml/*.py
!ml/*.md
!ml/requirements*.txt

# Keep asset metadata (but not binaries)
!assets/**/*.json
!assets/**/*.md

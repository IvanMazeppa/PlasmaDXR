# Blender Librarian Environment Variables
# Copy this file to .env and fill in your values

# Required: OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Model override (default: gpt-5.2)
# OPENAI_MODEL=gpt-5.2

# Optional: Monthly budget limit in USD (default: 10.0)
# MONTHLY_BUDGET=10.0

# Optional: Project root (auto-detected if not set)
# PROJECT_ROOT=/path/to/PlasmaDXR

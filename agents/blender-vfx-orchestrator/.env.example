# OpenAI API key for GPT-5.2
OPENAI_API_KEY=

# Optional: Monthly budget limit in USD (default: $20)
MONTHLY_BUDGET_USD=20

# Optional: Vector store ID for semantic Blender documentation search (Strategy 1)
# Create a vector store at https://platform.openai.com/storage/vector_stores
# Then run: python scripts/upload_blender_docs_to_vectorstore.py
BLENDER_DOCS_VECTOR_STORE_ID=

# Optional: State directory for session persistence
# STATE_DIR=build/orchestrator_state

# ========================================
# Model Configuration (all default to gpt-5.2)
# ========================================
# All agents now use GPT-5.2 with reasoning for full Agents SDK integration.
# Override these only if you need to test with different models.

# Orchestrator: gpt-5.2 with medium reasoning (main coordinator)
# ORCHESTRATOR_MODEL=gpt-5.2

# Script Writer: gpt-5.2 with high reasoning (code generation)
# SCRIPT_WRITER_MODEL=gpt-5.2

# Executor: gpt-5.2 with medium reasoning (error handling)
# EXECUTOR_MODEL=gpt-5.2

# Quality Analyst: gpt-5.2 with high reasoning (quality judgment)
# QUALITY_ANALYST_MODEL=gpt-5.2

# Learning Agent: gpt-5.2 with high reasoning (pattern recognition)
# LEARNING_AGENT_MODEL=gpt-5.2

# Docs Expert: gpt-5.2 with medium reasoning (documentation search)
# DOC_EXPERT_MODEL=gpt-5.2

# ========================================
# MCP Server Ports (optional)
# ========================================
# SCRIPT_GENERATOR_PORT=8101
# BLENDER_EXECUTOR_PORT=8102
# ASSET_EVALUATOR_PORT=8103
# EXPERIMENT_TRACKER_PORT=8104

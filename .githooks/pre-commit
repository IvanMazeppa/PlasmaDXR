#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Running secret guardrail (.env.example templates)..."
python3 scripts/secret_guardrail.py

# Version Enforcement - Catches AI training data contamination
echo "[pre-commit] Running version enforcement (AI training data check)..."
ORCHESTRATOR_DIR="agents/blender-vfx-orchestrator"

if [ -f "$ORCHESTRATOR_DIR/version_enforcement.py" ]; then
    # Get staged Python files in orchestrator (exclude known-fix files)
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^$ORCHESTRATOR_DIR/.*\.py$" | grep -v "api_validator.py" | grep -v "blender_api_fixer.py" | grep -v "version_enforcement.py" || true)

    if [ -n "$STAGED_FILES" ]; then
        VIOLATIONS=""
        for file in $STAGED_FILES; do
            OUTPUT=$(python3 "$ORCHESTRATOR_DIR/version_enforcement.py" "$file" 2>&1 || true)
            if echo "$OUTPUT" | grep -q "VIOLATIONS FOUND"; then
                VIOLATIONS="$VIOLATIONS\n$OUTPUT"
            fi
        done

        if [ -n "$VIOLATIONS" ]; then
            echo ""
            echo "========================================"
            echo "VERSION ENFORCEMENT FAILED"
            echo "========================================"
            echo -e "$VIOLATIONS"
            echo ""
            echo "Your code contains patterns from outdated AI training data."
            echo "See: agents/blender-vfx-orchestrator/VERSION_TRUTH.md"
            echo ""
            exit 1
        fi
    fi
    echo "[pre-commit] Version enforcement: PASSED"
fi

